# AgoraEuFalo • Exemplo de Configuração de Ambiente
# COPIE ESTE ARQUIVO PARA .env E INSIRA SUAS CREDENCIAIS REAIS (NUNCA COMMITE O .env)

# Google Gemini API Key (Modelos 3.0+ / TTS & Raciocínio)
GEMINI_API_KEY="your_gemini_api_key_here"

# Hotmart Webhook Hottok / Secret (Token de verificação de autenticidade)
HOTMART_HOTTOK_SECRET="your_hotmart_hottok_secret_here"

# Firebase Config (Cliente Web público)
FIREBASE_PROJECT_ID="agoraeufalo-3463a"
FIREBASE_AUTH_DOMAIN="agoraeufalo-3463a.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="agoraeufalo-3463a.firebasestorage.app"
