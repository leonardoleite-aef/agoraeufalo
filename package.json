{
  "name": "agoraeufalo-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site Oficial AgoraEuFalo - Prof. Leonardo Leite",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cd v2-pdf-factory && npm run build && cd .. && node scripts/build_dist.js",
    "preview": "vite preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/core/**/*.test.ts",
    "type-check": "tsc --noEmit --strict",
    "postinstall": "cd v2-pdf-factory && npm install"
  },
  "devDependencies": {
    "puppeteer": "^25.10.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "acorn": "^8.18.0",
    "dotenv": "^18.0.5",
    "firebase-admin": "^14.5.0"
  }
}
